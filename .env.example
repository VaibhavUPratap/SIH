# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://uei_user:password@localhost:5432/uei_db
# Alternative for MySQL: mysql+pymysql://user:password@localhost:3306/uei_db

# MongoDB Configuration (Optional)
MONGODB_URI=mongodb://localhost:27017/uei_db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Aadhaar Mock API (for development)
AADHAAR_API_URL=https://mock-aadhaar-api.example.com
AADHAAR_API_KEY=mock-api-key

# MFA Configuration
MFA_ISSUER_NAME=UEI-Platform
MFA_ENABLED=True

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password

# Application Configuration
APP_NAME=Unified Education Interface
APP_URL=http://localhost:5000
PAGINATION_PER_PAGE=20

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png

# Analytics Configuration
ENABLE_ANALYTICS=True
ML_MODEL_PATH=models/ml_models

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/uei.log

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100/hour
